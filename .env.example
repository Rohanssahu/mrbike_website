# Copy to .env.local and fill in real values for local development.
# All client-exposed variables MUST be prefixed with NEXT_PUBLIC_.

# Canonical site URL (no trailing slash) — used for metadataBase, sitemap, robots, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://mrbikedoctor.com

# Mobile app store links promoted by the marketing site.
NEXT_PUBLIC_IOS_APP_URL=
NEXT_PUBLIC_ANDROID_APP_URL=

# Analytics / search console.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Business contact details (used in LocalBusiness JSON-LD and footer/contact CTAs).
NEXT_PUBLIC_CONTACT_EMAIL=support@mrbikedoctor.com
NEXT_PUBLIC_CONTACT_PHONE=
